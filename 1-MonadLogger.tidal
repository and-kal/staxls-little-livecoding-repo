  midiN chan = s "midi" # midichan (chan - 1) -- ^ make MIDI channels 1-indexed
  melody = "[0 7 5 7 5 2 11 1 0 7 5 9 12 2 11 1]"
  pattern = binary "<<1274 1275>!4 <1174 1195>!4 <1000 1003>!4>"
  lforand chan val1 val2 =
    ccn chan
    # ccv (segment 50 (range val1 val2 $ rand)) 
    # s "midi" -- ^ this one is for sending one random value per cycle
in
d1
