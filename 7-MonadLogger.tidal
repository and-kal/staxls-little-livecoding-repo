-- change drums

-- TODO: shape kick and mix 

let
  midilfo chan val = ccv (segment 50 $ val) # ccn (96 + chan) # s "midi" 
  midicc chan val = ccv val # ccn (96 + chan) # s "midi" 
  pat_1 = binary "<[1122, 4499]*2 [2004, 4894]*2>"
  pat_2 = binary "<[122, 279]*2 [3111, 1814]*2>"
  pat_3 = ascii "<co Rp Os>"
in
d7
$ someCyclesBy (2/3) (rev) 
$ whenmod 34 31 (slow 6) 
-- $ whenmod 12 11 (slow 3) 
$ whenmod 20 17 (linger (1/18)) 
$ stack [
  struct (inv pat_3) $ n "0 1 1 0" # midiN 10 -- ^ phased snare
  ,
  struct pat_2 $ n "0 1" # midiN 9 -- ^ kicks
  ,
  n "0*8" # midiN 11
  ,
  n "~ 0" # midiN 12 
  ,
  midicc 1 "<0!4 120!2>"
  ,
  sometimes (0.25 <~) $ midilfo 13 (range 0 127 $ fast "[1|2|3|4]" $ sine)  
  ,
  sometimes (0.25 ~>) $ midilfo 14 (range 0 127 $ fast "[1|2|3|4]" $ sine)  
]
# cps (171/60/4)
-- # cps (range (155/60/4) (155/60/5) $ slow 4 $ sine)

d7 $ silence

hush