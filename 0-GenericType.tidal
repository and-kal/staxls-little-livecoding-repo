$ 
soak 12 (fast 1.2) $ s "[808hc, bd sd/2 <cp? [cp/4]!3>]"
# cps (166/60/4)

hush

d1 $ note ( scale "aeolian"
          $ snowball 8 (+) (slow 2 . rev) "0 3 _ -1 _ 5 7 4 _ ~ -2"
          )
   # s "gtr"

  hush

d1 $ sometimes loopFirst $ s "<<[bd*2 ~!2 sd:6*2] 808sd:3*8> cp*4>" # cps (151/60/2)

d1 $ timeLoop 7 $ s "<bd sn cp hh>"

d3 
$ spaceOut [(5/3), 1.5, (4/3), 1.25, 1, (7/8), 0.75, (2/3)]
  $ s (fmap (["bd:18", "sd"]!!) 
  $ markovPat 16 0 [ 
    [3, 5], 
    [3, 8] 
  ])
# cps (160/60/4)

hush

d3 

$ stack [
  palindrome $ stutter 6 (1/16) $ s "bd cp" 
  , stutter 12 (1/16) $ s "808hc" 
]
# cps (165/60/4)

hush

d1 
$ substruct (ascii "<T C>") $ s "bd sd"

d1 $ sometimesBy (1/4) ((1/4) <~) $ revArc (0.25, 0.75) $ s "[bd*4 sd*4] sd"

hush
