let 
  xenscale n = map (\x -> x / n * 12) [0..(n-1)]
  xen n p = toScale (xenscale n) p
in
  d1 $ note (xen 9 "0 1 2 5") # s "superpiano"

d1 
$ spaceOut [(5/3), 1.5, (4/3), 1.25, 1, (7/8), 0.75, (2/3)]
  $ s (fmap (["bd:18", "sd"]!!) 
  $ markovPat 16 0 [ 
    [3, 5], 
    [3, 8] 
  ])
# cps (160/60/4)
