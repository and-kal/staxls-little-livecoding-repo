
-----------------------------------
--           part six            --
--                               --
--   relevant note channels      --
--      5,6,7,8                  --
--                               --
--     81-84:                    --
--     85-88:                    --
--     89-92:                    --
--     93-96:                    --
-----------------------------------

let 
  basePat = "0 ~!2 0 ~!2 1 ~"
  cclfo chan val = ccv (segment 32 $ val) # ccn (80 + chan) # s "midi" -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
in
d6
$
-- always (bite 4 "1 2 0 3")
-- $
whenmod 12 9 (slow 3)
-- $
-- whenmod 17 13 (soak 2 (fast (4/3)))
-- $
-- degradeBy 0.8
$
stack [
  fast 2 $ n basePat # midiN 5 -- bass
  ,
  stack [
    fast 2 $ n "~ 3!2 ~ 3!2 ~ 3" # midiN 6 -- ticks
    ,
    n "~ 4*8" # midiN 6 -- shaker
    ,
    slow 2 
    $
    every 2 (0.125 <~)
    $
    every 3 (fast "0.5 2")
    $
    whenmod 6 3 (fast "2")
    $
    n "~ 1 ~*2 2" # midiN 6 -- snares
    ,
    whenmod 12 9 (const $ n "0*3 1*3") $ fast 2 $ (|+ n 5) $ n basePat # midiN 6 -- kick
    ,
    fast 2 $ n basePat # midiN 7 -- voc 
    # silence
    ,
    cclfo 121 0 -- voc selector
    ,
    every 4 (|+ n 11) 
    $
    every 13 (|+ n 5) 
    $ n "-5" # legato 0.3
    # midiN 8 -- stab
    # silence
  ]
]
# cps (161/60/4)

hush
