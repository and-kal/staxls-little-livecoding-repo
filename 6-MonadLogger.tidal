
-----------------------------------
--           part six            --
--                               --
--   relevant note channels      --
--      5,6,7,8                  --
--                               --
--     81-84:                    --
--     85-88:                    --
--     89-92:                    --
--     93-96:                    --
-----------------------------------

let 
  basePat = "{0 ~!2 0 ~!2 1 _ 7!24}%8"
  fill = whenmod 17 13
  fillPat = "0!24"
  cclfo chan val = ccv (segment 32 $ val) # ccn (5*4*4 + chan) # s "midi" -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
  slowed = whenmod 12 9
in
d6
$
every 4 (bite 4 "1 2 0 3")
$
slowed (slow 3)
$
fill (soak 2 (fast (4/3)))
$
whenmod 32 29 (degradeBy 0.8)
$
stack [
  fill (# n fillPat)
  $
  fast 2 $ n basePat # midiN 5 -- ^ bass
  ,
  stack [
    fast 2 $ n "~ 3!2 ~ 3!2 ~ 3" # midiN 6 -- ^ ticks
    ,
    n "~ 4*8" # midiN 6 -- ^ shaker
    ,
    slow 2 
    $
    every 2 (0.125 <~)
    $
    every 3 (fast "0.5 2")
    $
    whenmod 6 3 (fast "2")
    $
    n "~ 1 ~*2 2*4" # midiN 6 -- ^ snares
    ,
    fast 2 $ (|+ n 5) $ n basePat # midiN 6 -- ^ kick
    ,
    whenmod 8 5 (# silence)
    $
    fast 2 $ n basePat # midiN 7 -- ^ voc 
    ,
    someCyclesBy (1/5) (|+ ccv 66)
    $
    slowed (|+ ccv 127)
    $
    cclfo 9 0 -- ^ voc selector
    ,
    slowed (|- n 7)
    $
    every 4 (|+ n 11) 
    $
    every 13 (|+ n 5) 
    $ n "-5" # legato 0.3
    # midiN 8 -- ^ stab
  ]
]
# cps (171/60/4)

hush