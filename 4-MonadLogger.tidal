-- TODO: different kick + wilder 303
-- break sounds weird

let 
  midicc chan val = ccv val # ccn (3 * 4 * 4 + chan) # s "midi" 
  cclfo chan val = ccv (segment 32 $ val) # ccn (3 * 4 * 4 + chan)  # s "midi" -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
  randlfo chan val1 val2 = ccv (segment 50 $ range val1 val2 $ slow 2 $ perlin) # ccn (3 * 4 * 4 + chan) # s "midi" 
  riddim = ascii "<t c ß>"
  muteIt = whenmod 30 20 (degradeBy 1) 
  -- mel303 = toScale [0,2,3,6,7,9,10] "[-3!8 -1 -5!4 -1 -3 -2]/2" -- ^ dorian#4
in
d4
