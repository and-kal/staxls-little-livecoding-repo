-----------------------------------
--           part four           --
--                               --
--   relevant note channels      --
--    13,14,15,16                --
--                               --
--     relevant CC channels      --
--     49-52:                    --
--     53-56:                    --
--     57-60:                    --
--     61-64:                    --
-----------------------------------

-- TODO: different kick + wilder 303
-- break sounds weird

let 
  midicc chan val = ccv val # ccn (3 * 4 * 4 + chan) # s "midi" 
  cclfo chan val = ccv (segment 32 $ val) # ccn (3 * 4 * 4 + chan)  # s "midi" -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
  randlfo chan val1 val2 = ccv (segment 50 $ range val1 val2 $ slow 2 $ perlin) # ccn (3 * 4 * 4 + chan) # s "midi" 
  riddim = ascii "<t c ß>"
  muteIt = whenmod 30 20 (degradeBy 1) 
  -- mel303 = toScale [0,2,3,6,7,9,10] "[-3!8 -1 -5!4 -1 -3 -2]/2" -- ^ dorian#4
in
d4
$ every 8 rev 
$ degradeBy 0.9
$ whenmod 20 16 (scramble 12)
$ stack [
  substruct (inv riddim) $ n "0" # midiN 13 -- kick
  ,
  muteIt $
  whenmod 24 21 (degradeBy 1) $
  substruct riddim $ n "[2]" # midiN 13 -- weirdhit
  ,
  muteIt $
  whenmod 11 9 (plyWith 4 ((|+ ccv 5)) . (rev) . (slow 2)) -- ^ ascending snare
  $
  stack [ -- ^ stack inside stack so we I can modulate CC conditionally
     fast 2 $ whenmod 8 6 (degradeBy 1) $ whenmod 7 5 (0.25 <~) $ n "1 ~ ~ 1" # midiN 13 -- snarey
     ,
     ccv 80 # ccn (3 * 4 * 4 + 1) # s "midi" -- ^ transpose snare
  ]
  , 
  randlfo 9 0 127 -- ^ "stab" pan
  ,
  every 7 (|+ ccv 100)
  $
  midicc 10 0 -- ^ "stab" vibrato
  ,
  muteIt $
  sometimes (|+ n "[1|12]") 
  $ n "<[0*8]!3 12*8>" # midiN 15 -- ^ sample "stab"
  ,
  cclfo 13 (range 0 "<0!6 90!2>" $ slow 2 saw) -- ^ break transpose
  ,
  sometimes (|+ n "[1|12]") 
  $ n "-24*8" # midiN 16 -- ^ breaks
  ,
  randlfo 5 100 0 -- ^ hat delaytime
  ,
  every 4 (|+ ccv 127)
  $
  midicc 6 0 -- ^ hat d/w
  ,
  sometimes (|+ n "2") $ n "0!8" # midiN 14 -- ^ glitchy hat particles
]
# cps (168/60/2)

hush

◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤
◢◤◢◤◢◤◢◤InTeRLuDe◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤
◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤◢◤

d5
$ 
whenmod 36 33 (# binshift (range 0 1 $ perlin)) $
whenmod 30 20 (fast 1.5) $
whenmod 14 12 (trunc 0.25) $
every 10 (# accelerate (range (-2) 2 $ slow 2 sine)) $
every 5 (jux rev) $
every 8 (# accelerate "[-1 1]") $
every 7 (# coarse "16 32 24") $
every 4 (chop 4 . rev) $
every 9 (stut 8 0.25 0.5) $
stack [
    whenmod 10 5 (# up "0 2 3 5") $
    fast 8 $
    sound "<jungle:6 jungle:6>" # up ( 
        spread ($) [(fmap (+12)), (fmap (+2))] -- ^ `($)` turns the function application operator into a function
        $ "[0 1]*4"
    ) 
    # cut "1" # shape 0.9 # amp 0.8
    ,
    sound "amencutup:12*8? amencutup:2*4" # shape "0 1"
    ,
    foldEvery [2,3] (fast 2) $ sound "{tech:5 tech:5 tech:5 tech:5 808oh}%8" -- ^ kicks
    # cut "2" # gain "0.95" 
    ,
    s "superpwm" # n (scale "wholetone" "<as4'min es4'min gs4'min>") # scram "[0.4|0.6|0.8]" 
    # gain 0.7 # resonance 0.8 # accelerate 0.2
] 
# amp 0.75
# shape 0.9
# distort 0
# cps(169/60/4)

hush