-- Ella: a d -> g c 

let
  pat1 = "{ 0*2 2*8 6*8 9!2 10*[1|2]!2 8!8 2*[1|2] }%4"
  bass = "[g4 _ _ _ g4 _ _ d4 _ g4 _ g4 c5 _ c5 _ a5 _ c5 _]/3" 
in
  d3
  $ stack [
    whenmod 15 9 (plyWith 4 (|+ ccv 20)) -- ^ ascending snare
    $ 
    ccv 0 # ccn 113 # s "midi"
    ,
    every 4 (rev)
    $
    whenmod 10 8 (fast 2) 
    $ 
    every 5 (shuffle 4) 
    $ 
    every 4 ((1/4) <~) 
    $
    someCyclesBy (1/1) (fast 2) $ n pat1 # midiN 9
    ,
    n bass # midiN 2
  ]
  # cps (187/60/64)

hush

-- ⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆
-- 🏺🏛️🧿🫒🏺🏛️🧿🫒🏺🏛️🧿🫒🏺🏛️🧿🫒🏺🏛️🧿🫒🏺🏛️🧿🫒
-- ⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺₊⋆⁺

let
  cclfo chan val = ccv (segment 32 $ val) # ccn (4 * 4 * 7 + chan)  # s "midi" 
  -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
in
d5 
$ whenmod 12 8 (sometimes loopFirst) 
$ whenmod 18 12 (sometimesBy (1/4) ((1/4) <~) . revArc (0.25, 0.75))
$ stack [
  n (scale "locrian" "<0 ~ 5 ~!2 4>") # midiN 13 -- ^ snarefxy
  ,
  someCyclesBy (1/4) (|* ccv (range 0 127 $ slow 4 $ perlin))
  $
  cclfo 1 50 -- ^ snarefxy delay warp
  ,
  (+ n "[0,[24|12|7]]") $ n (scale "locrian" "<fs3'min11'o gs3'm7f5'i>") # midiN 14 -- pad
  ,
  degradeBy (2/3) $ 
  every 8 (|- n 7) $ 
  n (scale "locrian" "<fs4'min11'o gs4'm7f5'o>")  # midiN 15 -- fx
  ,
  n (scale "locrian" "<~!2 0 ~ -4>")  # midiN 16 # legato 1.5 -- subbbass
]
  # cps (161/60/4)

hush




-----------------------------------
--           part two            --
--                               --
--   relevant note channels      --
--      9,10,11,12               --
--                               --
--     relevant CC channels      --
--     17-20:                    --
--     21-24:                    --
--     25-28:                    --
--     29-32:                    --
-----------------------------------


let 
   cclfo chan val = ccv (segment 32 $ val) # ccn (4 * 4 + chan) # s "midi" -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
in
d2
$ 
every 6 rev
$
every 7 (slow 2 . ply 2)
$
whenmod 11 6 (ply 3 . slow 2.5) 
$
stack [
  every 4 (|- n 3) $ 
  every 5 (|+ n 6) $ 
  beat "[3,4.2,9,11,12,14]" 16 $ n "-24" # midiN 9 -- kick
  ,
  cclfo 1 (slow 8 $ range 0 50 tri) -- kickfmfeedb
  ,
  cclfo 2 (slow 7 $ range 0 50 tri) -- kickdecay
  ,
  whenmod 9 6 (|+ ccv 25) $ ccn 19 # ccv 0 # s "midi" -- kickfmlevel
  ,
  cclfo 5 (segment 32 $ slow 3 $ range 60 127 tri) -- snare delay
  ,
  beat "[4.9,15.3]" 16 $ n "1" # midiN 10 -- snare
  ,
  beat "[0.1,3,4.2,9,11,12,14,4.9,15.3]" 16 $ n "0" # midiN 11 -- hat
  ,
  note (scale "minor" "<fs5'min5 gs4'min4'o d4'min4'ii>") # legato 2 
  # midiN 12
] # cps (154/60/4)

-----------------------------------
--           part five           --
--                               --
--   relevant note channels      --
--      1,2,3,4                  --
--                               --
--     65-68:                    --
--     69-72:                    --
--     73-76:                    --
--     77-80:                    --
-----------------------------------

-- add something on chan 3 + 4

-- assoc group 
let 
  midicc chan val = ccv val # ccn (4**3 + chan) # s "midi" 
  midilfo chan val = ccv (segment 50 $ val) # ccn (4**3 + chan) # s "midi" 
  pat = ascii "<ha [H A] <hA Ha>>"
  in
d5
$
whenmod 8 5 (slow "2 1 4 1 2")
$
whenmod 12 8 ((slow 2) . (bite 4 "0 2 3 1"))
-- $ 
-- always ((slow 4) . (spaceOut [(5/3), 1.5, (4/3), 1.25, 1, (7/8), 0.75]))
$
  stack [
    whenmod 14 10 (shuffle 8) 
    $
    someCyclesBy (1/4) (|- n 24) 
    $ n (run 16) # midiN 1
    ,
    midilfo 1 (range 0 37 $ rand)
    ,
    fast 4 $ midicc 2 "[0|127]"
    ,
    struct (pat) $ n "0" # midiN 2
    -- ,
    -- struct (inv (pat)) $ n "0" # midiN 3
    ,
    (|- n 12)
    $
    n "<e gs ds>" # midiN 4 # legato 2
]
# cps(166/60/4)

hush


-----------------------------------
--           part six            --
--                               --
--   relevant note channels      --
--      5,6,7,8                  --
--                               --
--     81-84:                    --
--     85-88:                    --
--     89-92:                    --
--     93-96:                    --
-----------------------------------

let 
  basePat = "{0 ~!2 0 ~!2 1 _ 7!24}%8"
  fill = whenmod 17 13
  fillPat = "0!24"
  cclfo chan val = ccv (segment 32 $ val) # ccn (5*4*4 + chan) # s "midi" -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
  slowed = whenmod 12 9
in
d6
$
every 4 (bite 4 "1 2 0 3")
$
slowed (slow 3)
$
fill (soak 2 (fast (4/3)))
$
whenmod 32 29 (degradeBy 0.8)
$
stack [
  fill (# n fillPat)
  $
  fast 2 $ n basePat # midiN 5 -- ^ bass
  ,
  stack [
    fast 2 $ n "~ 3!2 ~ 3!2 ~ 3" # midiN 6 -- ^ ticks
    ,
    n "~ 4*8" # midiN 6 -- ^ shaker
    ,
    slow 2 
    $
    every 2 (0.125 <~)
    $
    every 3 (fast "0.5 2")
    $
    whenmod 6 3 (fast "2")
    $
    n "~ 1 ~*2 2*4" # midiN 6 -- ^ snares
    ,
    fast 2 $ (|+ n 5) $ n basePat # midiN 6 -- ^ kick
    ,
    whenmod 8 5 (# silence)
    $
    fast 2 $ n basePat # midiN 7 -- ^ voc 
    ,
    someCyclesBy (1/5) (|+ ccv 66)
    $
    slowed (|+ ccv 127)
    $
    cclfo 9 0 -- ^ voc selector
    ,
    slowed (|- n 7)
    $
    every 4 (|+ n 11) 
    $
    every 13 (|+ n 5) 
    $ n "-5" # legato 0.3
    # midiN 8 -- ^ stab
  ]
]
# cps (171/60/4)

hush



-----------------------------------
--           part eight          --
--                               --
--   relevant note channels      --
--    13,14,15,16                --
--                               --
--     relevant CC channels      --
--     113-116                   --
--     117-120                   --
--     121&122                   --
--     124-127                   --
-----------------------------------

let
  mel_1 = "{<4!4 [0 3 2 7] [1 0 2 0] 5!2 0 9!3>}%12"
  pat_1 = "{<0!4 [0 2 4 6] [0 7 9 12] 0!2 0 9!3>}%6"
  struct_1 = binary "<23973 3456>"
in
d8
  -- $ slow 8
  $ stack [
  sometimes (|+ n 7) 
  $ 
  someCyclesBy (1/4) (shuffle 4) 
  $ 
  someCyclesBy (1/2) (|- n "[12|24]") 
  $ 
  n (scale "hexDorian" mel_1) # midiN 13
  , 
  whenmod 14 8 (shuffle 12) 
  $
  n (scale "hexDorian" pat_1) # midiN 14
  ,
  someCyclesBy ("[0.5|0.25]") ("[0.5|0.25]" <~)
  $
  fast 2 
  $ struct (inv struct_1) $ n "[-4 3]" # midiN 15
  ,
  someCyclesBy (1/4) (fast 1.5) $ n "0*6" # midiN 16
]
# cps (132/60/4)

d8 $ silence

hush