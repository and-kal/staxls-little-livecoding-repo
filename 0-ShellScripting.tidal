-- Ella: a d -> g c 

let
  pat1 = "{ 0*2 2*8 6*8 9!2 10*[1|2]!2 8!8 2*[1|2] }%4"
  bass = "[g4 _ _ _ g4 _ _ d4 _ g4 _ g4 c5 _ c5 _ a5 _ c5 _]/3" 
in
  d3
  $ stack [
    whenmod 15 9 (plyWith 4 (|+ ccv 20)) -- ^ ascending snare
    $ 
    ccv 0 # ccn 113 # s "midi"
    ,
    every 4 (rev)
    $
    whenmod 10 8 (fast 2) 
    $ 
    every 5 (shuffle 4) 
    $ 
    every 4 ((1/4) <~) 
    $
    someCyclesBy (1/1) (fast 2) $ n pat1 # midiN 9
    ,
    n bass # midiN 10
  ]  # cps (187/60/4)

hush