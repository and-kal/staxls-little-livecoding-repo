
-------------------------------------------------
--           part one                          --
--                                             --
--   relevant note channels                    --
--      1,2,3,4                                --
--                                             --
--                                             --
-- fader 1: vox                                --
-- fader 2: contact mic                        --
-------------------------------------------------

let 
    pattern = "{0@6 1@3 1@3 1@3 1*2@6 0@8 2@8 3@6 3@2}%512"
    midiN chan = s "midi" # midichan (chan - 1) 
in
d1
$ whenmod 12 9 (slow 12)
$ whenmod 24 14 (fast "[1.5|2.5]")
$ whenmod 30 25 (ply 3)
$ stack [ 
  (|- n 24)
  $
  n (unwrap $ fmap (["~", "0", "2", "1"]!!) $ pattern)
  # midiN 1
  , 
  (|- n 24)
    $
  n (unwrap $ fmap (["3", "3", "3", "3"]!!) $ pattern) 
  # midiN 1
  ,
  (|- n 12) $ n (scale "phrygian" (unwrap $ fmap (["[0|2|4]", "~", "~", "~"]!!) $ pattern))
  # midiN 2 # legato 1
  ,
  sometimesBy (1/6) (|+ n "[24|-24]")
  $
  slow 4 $ n (scale "wholetone" "g4")
  # midiN 3 
  ,
  n (unwrap $ fmap (["[0,1]", "~", "~", "~"]!!) $ pattern) 
  # midiN 4 
]
  # cps(80/60/2)

hush

-------------------------------------------------
--           part two                          --
--                                             --
--   relevant note channels                    --
--      5,6,7,8                                --
--                                             --
-------------------------------------------------

d2 
$
let 
    kick = "0 ~ 0 ~ ~ 0 ~"
    hat = "-24*6"
    snap = "~ -23 ~ -23 ~ -23"
    midiN chan = s "midi" # midichan (chan - 1) 
in
  someCyclesBy (1/4) (0.125 <~)
  $ whenmod 100 70 (ply 2)
  $ whenmod 150 140 (slow 8) 
  $ whenmod 120 100 (degradeBy 0.9) 
  $
  stack [
    n kick # midiN 5,
    n hat # midiN 6,
    n snap # midiN 6
  ]
  # cps(444/60/2)

hush

-------------------------------------------------
--           part three                        --
--                                             --
--   relevant note channels                    --
--      9,11,12                                --
--                                             --
-- fader 4: chain select                       --
-------------------------------------------------

d3 
-- $ every 5 (chew 4 "0*2 1 2*3 1 3") 
$ every 6 (fast 1.25) 
$ every 8 (bite 4 "0*2 1 2*2 1 3") 
$ whenmod 20 18 (slow 8) 
$ stack [
  n "0*16" # s "midi" # midichan 8
  , 
  slow 6 $ n "~!7 [0*[4|8]]!5" # s "midi" # midichan 10
  , 
  n "-12*8 -12*8" # s "midi" # midichan 11
]
# cps(199/60/4)

hush

-------------------------------------------------
--           part four                         --
--                                             --
--   relevant note channels                    --
--      13,14,15,16                            --
--                                             --
-- fader 5: vox (use in conjuction w/ fader 1) --
-- fader 6: distortion                         --
-------------------------------------------------

d4
$
trigger
$
stack [
  someCycles (# up 1) $ n "[0 [0*2 ~]]/2" # s "midi" # midichan 13
  , n "~ [-24|-22]" # s "midi" # midichan 12
  , every 8 (fast "[2 4]") $ n "-23*8" # s "midi" # midichan 12
  , 
  n "[[5@3 1] 0 2 [3 1@2 6]]/4" # s "midi" # midichan 14
]
  # cps (115/60/4)

hush

-------------------------------------------------
--           encore                            --
--                                             --
--   relevant note channels                    --
--      1,2,3,4                                --
-- fader 7: melody                             --
-- might use f. 1 and 5, too                   --
-------------------------------------------------

d6
$
stack [
  whenmod 12 9 (# up (-3)) $ 
  -- whenmod 20 13 (ply 2) $
  whenmod 20 13 (fast 2) $
  n "0*4" # s "midi" # midichan 0
  , 
  whenmod 24 16 (|+ n 5) $ n (scale "neapolitanMinor" "<4 5 4 3 2 3 2 0 4 5 4 3 2 3 4 0>*2") # s "midi"  # midichan 1 
  , n "-24/8" # s "midi"  # midichan 2
  , n "[-23*2]" # s "midi"  # midichan 2
]
  # cps (215/60/2)

hush
