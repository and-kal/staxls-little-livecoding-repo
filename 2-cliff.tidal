
-------------------------------------------------
--           part one                          --
--                                             --
--   relevant note channels                    --
--      1,2,3,4                                --
--                                             --
--                                             --
-- fader 1: vox                                --
-- fader 2: contact mic                        --
-------------------------------------------------

let 
    pattern = "{0@6 1@3 1@3 1@3 1*2@6 0@8 2@8 3@6 3@2}%666"
    midiN chan = s "midi" # midichan (chan - 1) 
    midilfo chan val = ccv (segment 50 $ val) # ccn chan # s "midi" 
in
clutchIn 1 12
$ whenmod 12 9 ((slow 16) . (ply 2))
$ whenmod 24 14 (fast "[1.5|2.5]")
$ whenmod 30 25 (ply 3)
$ stack [ 
  (|- n 24)
  $
  n (unwrap $ fmap (["~", "0", "2", "1"]!!) $ pattern)
  # midiN 1
  , 
  (|- n 24)
  $
  n (unwrap $ fmap (["3", "3", "3", "3"]!!) $ pattern) 
  # midiN 1
  ,
  (|- n 12) $ n (scale "iwato" (unwrap $ fmap (["[0|2|4]", "~", "~", "~"]!!) $ pattern))
  # midiN 2 # legato 1
  ,
  sometimesBy (1/6) (|+ n "[3|-4]")
  $ n "gs5'7f10"
  # midiN 3 
  ,
  n (unwrap $ fmap (["[0,1]", "~", "~", "~"]!!) $ pattern) 
  # midiN 4 
  -- , 
  -- whenmod 13 9 (|+ ccv 80) $ midilfo 1 27
]
  # cps(100/60/2)

hush

-------------------------------------------------
--           part two                          --
--                                             --
--   relevant note channels                    --
--      5,6,7,8                                --
--                                             --
-------------------------------------------------

let 
    kick = "0 ~ 0 ~ ~ 0 ~"
    hat = "-24*6"
    snap = "~ -23 ~ -23 ~ -23"
    midiN chan = s "midi" # midichan (chan - 1) 
in
d2 
$
  someCyclesBy (1/4) (0.125 <~)
  $ whenmod 100 70 (ply 2)
  $ whenmod 150 140 (slow 2) 
  $ whenmod 120 100 (degradeBy 0.9) 
  $
  stack [
    n kick # midiN 5,
    n hat # midiN 6,
    n snap # midiN 6,
    n "c2" # midiN 7,
    someCyclesBy (1/8) (|+ n "[7|-12]") $ n "g5'm11*2" # midiN 8
  ]
  # cps(666/60/2)

hush

-------------------------------------------------
--           part three                        --
--                                             --
--   relevant note channels                    --
--      9,11,12                                --
--                                             --
-- fader 4: chain select                       --
-------------------------------------------------

d3 
-- $ every 5 (chew 4 "0*2 1 2*3 1 3") 
-- $ every 6 (fast 1.25) 
-- $ every 8 (bite 4 "0*2 1 2*2 1 3") 
-- $ whenmod 20 18 (slow 8) 
$ stack [
  -- n "0*16" # s "midi" # midichan 8
  -- , 
  -- slow 6 $ n "~!7 [0*[4|8]]!5" # s "midi" # midichan 10
  -- , 
  -- n "-12*8 -12*8" # s "midi" # midichan 11
  -- , 
  n "0*8 0*12" # s "midi" # midichan 11
]
# cps(199/60/4)

hush

-------------------------------------------------
--           part four                         --
--                                             --
--   relevant note channels                    --
--      13,14,15,16                            --
--                                             --
-- fader 5: vox (use in conjuction w/ fader 1) --
-- fader 6: distortion                         --
-------------------------------------------------
let
  midiN chan = s "midi" # midichan (chan - 1) 
in
d4
$
whenmod 56 40 (slow 12)
$
whenmod 40 30 (ply 4)
$
stack [
  someCycles (fast 1.5) $ n "[0*4 [0*3 ~]]/2" # midiN 14
  , 
  n "[-24*12|-22*12]" # midiN 13
  , 
  every 8 (fast "[2 4]") $ n "-23*12" # midiN 13
  , 
  (|- n 24) $ shuffle 8 $ n "[0..7]" # midiN 15
]
  # cps (365/60/2)

hush

-------------------------------------------------
--           encore                            --
--                                             --
--     don't forget to unmute                  --
-------------------------------------------------
let
  midiN chan = s "midi" # midichan (chan - 1) 
  midilfo chan val = ccv (segment 50 $ val) # ccn chan # s "midi" 
in
d5
$
  whenmod 20 13 palindrome $
  whenmod 32 26 (fast (4/3)) $
stack [
  whenmod 12 8 (# up (-12)) $ 
  n "<[0*4]!15 ~>" # midiN 1
  , 
  fast 2 $ whenmod 54 32 (|+ n 24) 
  $ shuffle 16 $ n (scale "neapolitanMinor" "<4 5 4 3 2 3 2 0 4 5 4 3 2 3 4 0>*2") 
  # midiN 2
  , 
  n "-24*4" # midiN 3
  , 
  n "[-23*2]" # midiN 3
  , 
  n (run 4) # s "midi" # midiN 4
]
# cps (396/60/2)

hush
