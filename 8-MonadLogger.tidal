-- TODO: add more CC fx

let
  mel_1 = "{<4!4 [0 3 2 7] [1 0 2 0] 5!2 0 9!3>}%12"
  pat_1 = "{<0!4 [0 2 4 6] [0 7 9 12] 0!2 0 9!3>}%6"
  dist = whenmod 16 14
  varcc = foldEvery [3, 7] (|+ ccv 127)
  midicc chan val = ccv val # ccn chan # s "midi" 
in
d8
  -- $ slow 8
  $ 
  stack [
  -- sometimes (|+ n 7) 
  -- $ 
  -- someCyclesBy (1/4) (shuffle 4) 
  -- $ 
  someCyclesBy (1/2) (|- n "[12|24]") 
  $ 
  -- dist (const $ silence)
  -- $
  n (scale "hexDorian" mel_1) # midiN 13 -- ^ bells
  ,
  ccv (
    whenmod 8 6 (const $ segment 50 (range 0 127 rand)) $
    pure 0 -- ^ `pure` explicitly turns `0` into a pattern again
  ) # ccn 113 # s "midi"
  -- , 
  -- whenmod 14 8 (shuffle 12) 
  -- $
  -- n (scale "hexDorian" pat_1) # midiN 14 -- ^ percs
  -- ,
  -- varcc 
  -- $
  -- midicc 121 0 -- ^ hats vibrato
  -- ,
  -- someCyclesBy ("[0.5|0.25]") ("[0.5|0.25]" <~)
  -- $ n mel_1 # midiN 15 -- ^ hats
  -- ,
  -- someCyclesBy (1/6) (fast 1.5) 
  -- $ 
  -- whenmod 10 7 (|- n 5) 
  -- $ 
  -- n "0*6" # midiN 16 -- ^ kick
  -- ,
  -- dist (|+ ccv 127) 
  -- $ 
  -- midicc 124 0 -- ^ distort kick
] # cps (132/60/4)

hush