
-----------------------------------
--           part two            --
--                               --
--   relevant note channels      --
--      5,6,7,8                  --
--                               --
--     relevant CC channels      --
--     17-20:                    --
--     21-24:                    --
--     25-28:                    --
--     29-32:                    --
-----------------------------------

let 
   cclfo chan val = ccv (segment 32 $ val) # ccn (4 * 4 + chan) # s "midi" -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
in
d2
$ 
every 4 (within (0.25, 0.75) (fast 1.5)) 
$ 
every 5 (ply 2)
$
every 8 ((slow 2) . (brak))
$
whenmod 14 8 (slow 2)
$
stack [
  n "[-4!8]" # midiN 5 -- ^ kick
  -- ,
  -- cclfo 1 (slow 8 $ range 0 50 tri) -- ^
  -- ,
  -- cclfo 2 (slow 7 $ range 0 50 tri) -- ^
  -- ,
  -- cclfo 5 (segment 32 $ slow 3 $ range 60 127 tri) -- ^
  ,
  someCyclesBy (1/3) (rev) 
  $ n "[~ [0 1] ~ 0]!2" # midiN 6 -- ^ "snare"
  ,
  n "12*16" # midiN 7 -- ^ hats
  ,
  someCyclesBy (1/3) (|- n 4) $ 
  someCyclesBy (1/4) (|+ n 2) $ 
  n "[e,b,es]*8" # midiN 8 -- ^ noise
] # cps (194/60/4)

hush