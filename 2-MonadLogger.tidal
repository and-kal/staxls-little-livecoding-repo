
-----------------------------------
--           part two            --
--                               --
--   relevant note channels      --
--      5,6,7,8                  --
--                               --
--     relevant CC channels      --
--     17-20:                    --
--     21-24:                    --
--     25-28:                    --
--     29-32:                    --
-----------------------------------

-- add hi-ends

let 
  cclfo chan val = ccv (segment 32 $ val) # ccn (4 * 4 + chan) # s "midi" -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
  midicc chan val = ccv val # ccn (4 * 4 + chan) # s "midi" 
in
d2
$ 
every 4 (within (0.25, 0.75) (fast 1.5)) 
$ 
every 5 (ply 2)
$
every 8 ((slow 2) . (brak))
$
whenmod 14 8 (slow 2)
$
stack [
  n "[-4!8]" # midiN 5 -- ^ kick
  ,
  whenmod 8 6 (|+ ccv 127)
  $
  midicc 1 0 -- ^ kick dist
  ,
  cclfo 2 (slow 7 $ range 0 50 tri) -- ^
  ,
  whenmod 9 7 (|+ ccv 127)
  $
  midicc 5 0 -- ^ snare bufferglitch
  ,
  someCyclesBy (1/3) (rev) 
  $ someCyclesBy (1/3) ((ply 4) . (slow 3)) 
  $ n "[~ [0 1] ~ 0]!2" # midiN 6 -- ^ "snare"
  ,
  n "12*16" # midiN 7 -- ^ hats
  ,
  foldEvery [4,5,9,10] (|+ ccv 127)
  $
  midicc 13 0 -- ^ amp noise
  ,
  someCyclesBy (1/3) (|- n 4) $ 
  someCyclesBy (1/4) (|+ n 1) $ 
  n "[e,es]*4" # midiN 8 -- ^ bassnoise
] # cps (194/60/4)

hush