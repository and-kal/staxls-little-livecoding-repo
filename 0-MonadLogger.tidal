let 
  pat1 = "{[0*[1|2|4]]/2 3![2|4|8] 11!4 9!4}%8"
  pat2 = "{0!2 2 9!2 3 9!2 1!3 5!3 1*[1|2|8] 0*[1|3] 1}%8"
  bass = "[fs4 _ _ _ fs4 _ _ fs4 _ fs4 _ fs4 cs5 _ cs5 _ e5 _ e5 _]/3" 
  kinte = "<b5 [a5 b5] fs5 [e5 fs5] e5 [cs5 c5] _>" 
in
  d1 
  $ stack [
    every 3 (shuffle 4) 
    $ 
    n pat1 # midiN 1
    ,
    n bass # midiN 2
    -- ,
    -- every 3 (rev) $ every 4 (const $ silence) $ slow 2 $ n kinte # midiN 3
    ,
    whenmod 30 20 (plyWith 4 ((|- ccv 7)) . (rev) . (slow 2)) -- ^ ascending snare
    $ ccv 66 # ccn 2 # s "midi"
    ,
    every 8 ((|+ ccv 127)) 
    $ ccv 0 # ccn 1 # s "midi"
  ]
  # cps (215/60/4)

hush

let 
  pat1 = "{0![2|4|8] 2 0 4![2|4|8] 0 7!3 2!2 10!2 8![2|4|8] 10!2}%8"
  pat2 = "{0!4 2*[1|4] 4![2|4|8]}%8"
  bass = scale "hexAeolian" "<-14 [-12 -7] -12 [-9 [-12]]>"
  synth = scale "hexAeolian" "<7 _ [-5 [12|0]] -5 _ [-9 _ _ [-2|7]] _>" 
  pad = scale "hexAeolian" "<as3'add9 _ _ e4'maj7'ii _>" 
in
  d2
  $ stack [
    whenmod 10 8 (fast 2) 
    $ 
    every 5 (shuffle 4) 
    $ 
    every 4 ((1/4) <~) 
    $ 
    every 3 (revArc (0.25, 0.75) ) 
    $ 
    n pat2 # midiN 5
    ,
    every 4 (rev)
    $
    someCyclesBy (1/1) (fast 2) $ n bass # midiN 6
    ,
    someCyclesBy (1/4) (fast 2) $ n synth # midiN 7
    ,
    someCyclesBy (1/4) (fast 2) $ n pad # legato 3 # midiN 8
  ]
  # cps (222/60/4)

hush

let 
  pat1 = "{ 0!2 2 6 9!2 10*[1|2]!2 8!3 2*[1|2] }%4"
in
  d3
  $ stack [
    every 4 (rev)
    $
    someCyclesBy (1/1) (fast 2) $ n pat1 # midiN 9
  ]
  # cps (177/60/4)

hush

