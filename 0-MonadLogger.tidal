d1
-- $
-- every 6 (slow 4 . rev)
$ 
soak 12 (fast 1.2) $ s "[808hc, bd sd/2 <cp? [cp/4]!3>]"
# cps (166/60/4)


let 
  xenscale n = map (\x -> x / n * 12) [0..(n-1)]
  xen n p = toScale (xenscale n) p
in
  d1 $ note (xen 9 "0 1 2 5") # s "superpiano"

d1 
$ spaceOut [(5/3), 1.5, (4/3), 1.25, 1, (7/8), 0.75, (2/3)]
  $ s (fmap (["bd:18", "sd"]!!) 
  $ markovPat 16 0 [ 
    [3, 5], 
    [3, 8] 
  ])
# cps (160/60/4)

-- assoc group 
let 
  midiN chan = s "midi" # midichan (chan - 1)
  midicc chan val = ccv val # ccn chan # s "midi" 
  midilfo chan val = ccv (segment 50 $ val) # ccn chan # s "midi" 
  in
d3 
$
whenmod 8 5 (slow "2 1 4 8 2")
$
whenmod 12 6 ((slow 2) . (bite 4 "0 2 3 1"))
$
  stack [
    -- whenmod 14 10 (shuffle 8) 
    -- $
    -- someCyclesBy (1/4) (|- n 24) 
    -- $ n (run 16) # midiN 9
    -- ,
    -- midilfo 55 (range 0 37 $ rand)
    -- ,
    -- fast 4 $ midicc 56 "[0|127]"
    -- ,
    -- struct (ascii "<ha [H A] <hA Ha>>") $ n "0" # midiN 10
    -- ,
    struct (inv (ascii "<ha [H A] <hA Ha>>")) $ n "0" # midiN 11
    ]
# cps(166/60/4)
