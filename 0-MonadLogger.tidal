let 
  pat1 = "{0!4 3![2|4|8] 11!4 9!4}%8"
  pat2 = "{0!2 2 9!2 3 9!2 1!3 5!3 1 0 1}%8"
  bass = scale "minPent" "<-5 [-2 0] [2 1 3 _] -5 [2 1 2 3]>" 
in
  d1 
  $ stack [
    every 3 (shuffle 4) 
    $ 
    n pat2 # midiN 5
    ,
    n bass # midiN 6
  ]
  # cps (202/60/4)

hush

let 
  pat1 = "{0![2|4|8] 2 0 4![2|4|8] 0 7!3 2!2 10!2 8![2|4|8] 10!2}%8"
  pat2 = "{0!4 2 4![2|4|8]}%8"
  reese = scale "hexAeolian" "<-14 [-12 [-17|12]] -10 [-7 [-12|17]]>"
  synth = scale "hexAeolian" "<0 _ [-2 [12|0]] -10 _ [-8 _ _ [-2|10]] _ -8>" 
  pad = scale "hexAeolian" "<as3'add9 _ _ e4'maj7'ii _>" 
in
  d2
  $ stack [
    every 5 (shuffle 4) 
    $ 
    -- every 4 ((1/4) <~) 
    -- $ 
    -- every 3 (revArc (0.25, 0.75) ) 
    -- $ 
    n pat2 # midiN 1
    ,
    someCyclesBy (1/4) (fast 2) $ n reese # midiN 2
    ,
    someCyclesBy (1/4) (fast 2) $ n synth # midiN 3
    -- ,
    -- someCyclesBy (1/4) (fast 2) $ n pad # legato 3 # midiN 4
  ]
  # cps (222/60/4)

hush

