-- # cps(132/60/4)

-----------------------------------
--           part one            --
--                               --
--   relevant note channels      --
--      1,2,3,4                  --
--                               --
--     relevant CC channels      --
--     1-4:                      --
--     5-8:                      --
--     9-12:                     --
--     13-16:                    --
-----------------------------------

-- TODO: EQ # fx to stab

let 
  midiN chan = s "midi" # midichan (chan - 1) -- ^ make MIDI channels 1-indexed
  melody = "[0 7 5 7 5 2 11 1 0 7 5 9 12 2 11 1]"
  pattern = binary "<<1274 1275>!4 <1174 1195>!4 <1000 1003>!4>"
  lforand chan val1 val2 = 
    ccn (1 * 4 + chan) 
    # ccv (segment 50 (range val1 val2 $ rand)) 
    # s "midi" -- ^ this one is for sending one random value per cycle
in
d1
$ whenmod 20 14 ((linger (1/8)) . (|- note 3) . (0.75 ~>))
$ stack [
    struct (pattern) 
    $ note 0
    # midiN 1 -- ^ kick
    ,
    ccn 1
    # ccv "<0!8 127!8>" -- ^ alternate synth
    # s "midi"
    , struct (inv pattern) 
    $ somecyclesBy 0.7 rev
    $ note "0 1 14"
    # midiN 2 -- ^ digits
    , 
    often (|+ n "[0|1|2|3]")
    $
    (|- n 24)
    $ n "0*16"
    # midiN 3 -- ^ particles
    ,
    fast 1.5 $ lforand 5 0 127
    ,
    fast 2 $ lforand 6 30 100
    ,
    (0.75 ~>)
    $ 
    whenmod 20 14 (const $ silence)
    $
    n "0*2"
    # midiN 4
] # cps(172/60/4)

hush

-----------------------------------
--           part two            --
--                               --
--   relevant note channels      --
--      5,6,7,8                  --
--                               --
--     relevant CC channels      --
--     17-20:                    --
--     21-24:                    --
--     25-28:                    --
--     29-32:                    --
-----------------------------------

--  TODO: find new synth

let 
   cclfo chan val = ccv (segment 32 $ val) # ccn (4 * 4 + chan) # s "midi" -- ^ this one is patterning CC values (`segment` necessary for applying continuous patterns/oscillators)
in
d2
$ 
every 6 rev
$
every 7 (slow 2 . ply 2)
$
whenmod 11 6 (ply 3 . slow 2.5) 
$
stack [
  every 4 (|- n 3) $ 
  every 5 (|+ n 6) $ 
  beat "[3,4.2,9,11,12,14]" 16 $ n "-24" # midiN 5 -- kick
  ,
  cclfo 1 (slow 8 $ range 0 50 tri) -- kickfmfeedb
  ,
  cclfo 2 (slow 7 $ range 0 50 tri) -- kickdecay
  ,
  whenmod 9 6 (|+ ccv 25) $ ccn 19 # ccv 0 # s "midi" -- kickfmlevel
  ,
  cclfo 5 (segment 32 $ slow 3 $ range 60 127 tri) -- snare delay
  ,
  beat "[4.9,15.3]" 16 $ n "1" # midiN 6 -- snare
  ,
  beat "[0.1,3,4.2,9,11,12,14,4.9,15.3]" 16 $ n "0" # midiN 7 -- hat
  ,
  slow 2 $ somecyclesBy(1/5) (|+ n 12) $ note (scale "hexSus" "<fs'min9 gs5'min6'o d5'min6'ii>") # legato 4 
  # midiN 8 -- too cheesy?
  -- might have to kill this channel manually, when note gets stuck
]
# cps (154/60/4)

hush

